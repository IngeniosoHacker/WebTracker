# Server
PORT=3000
NODE_ENV=production

# Postgres (Railway provides this automatically when you attach a Postgres plugin)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Redis (Railway provides this automatically when you attach a Redis plugin)
REDIS_URL=redis://default:password@host:6379

# Comma separated list of origins allowed to send tracking data.
# Use "*" only for testing. In production list your real site domains.
ALLOWED_ORIGINS=https://client-site-1.up.railway.app,https://client-site-2.up.railway.app

# Comma separated list of site IDs allowed to report data (created via /api/sites or manually in DB).
# Leave empty to accept any siteId (not recommended for production).
REQUIRE_KNOWN_SITE=true

# Session inactivity timeout, in minutes, before a session is considered finished
SESSION_TIMEOUT_MINUTES=30

# How often (ms) the flush worker moves events from Redis to Postgres
FLUSH_INTERVAL_MS=2000

# Batch size per flush cycle
FLUSH_BATCH_SIZE=200

# How often (ms) the sweeper checks for expired/abandoned sessions
SWEEP_INTERVAL_MS=60000

# Max characters of page content stored per pageview (for content analysis)
CONTENT_MAX_CHARS=8000

# Simple write-key required from the tracker script (optional shared secret, not a real auth system)
INGEST_KEY=
